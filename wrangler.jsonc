{
  "name": "kanachin-app-collection",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker.js",
  "d1_databases": [
    {
      "binding": "KICK_GIFT_DB",
      "database_name": "kick-gifts",
      "database_id": "a02750be-3819-4c78-9197-290b64d0f686"
    }
  ],
  "compatibility_flags": [
    "enable_ctx_exports"
  ],
  "migrations": [
    {
      "tag": "ranking-live-v1",
      "new_sqlite_classes": [
        "RankingLiveHub"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/3 * * * *"
    ]
  }
}
